# ── Database (Turso) ──────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# ── Auth (NextAuth.js v5) ─────────────────────────────────────
AUTH_SECRET=                        # openssl rand -base64 32
AUTH_GOOGLE_ID=                     # Google OAuth client ID
AUTH_GOOGLE_SECRET=                 # Google OAuth client secret
ADMIN_EMAIL=                        # First-user admin bootstrap (email promoted to admin on first sign-in)

# ── Model Providers (env var fallbacks — admin UI overrides) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=                   # Optional: budget provider
GROQ_API_KEY=                       # Optional: free tier provider

# ── Observability (Langfuse) ──────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=http://localhost:3001

# ── Durable Execution (Trigger.dev) ──────────────────────────
TRIGGER_SECRET_KEY=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
